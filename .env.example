# FindMyFiles Environment Configuration

# =============================================================================
# Backend Configuration
# =============================================================================
# Log Messages for SQLite Databases
SQL_ECHO = False

# =============================================================================
# LLM API Configuration (OpenAI-compatible providers)
# =============================================================================
# Supports Groq, OpenAI, or any OpenAI-compatible provider

# API Key (required for image captioning and audio transcription)
# For Groq: starts with "gsk_..."
# For OpenAI: starts with "sk-..."
LLM_API_KEY=your_api_key_here

# Base URL for the API (default: Groq)
# Groq: https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
# Local/Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Vision model for image captioning
# Groq options: qwen/qwen3.6-27b, llama-3.2-11b-vision-preview
# OpenAI options: gpt-4o, gpt-4o-mini
LLM_VISION_MODEL=qwen/qwen3.6-27b

# Audio model for transcription
# Groq options: whisper-large-v3-turbo, whisper-large-v3
# OpenAI options: whisper-1
LLM_AUDIO_MODEL=whisper-large-v3-turbo

# =============================================================================
# Redis Configuration (for Celery task queue)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Frontend Configuration
# =============================================================================
FINDMYFILES_BACKEND_URL=http://127.0.0.1:8000
